# Server-only TEMPLATE. Copy to root .env.server (gitignored), never frontend build.
# Do not fill or enable external IO until auth/DB operation is separately approved.
ASSISTANT_PROVIDER=fake
TRAINING_SECURITY_MODE=verified
TRAINING_ALLOW_EXTERNAL_IO=false
TRAINING_AUTH_ORIGIN=
TRAINING_AUTH_PUBLIC_KEY=
TRAINING_ALLOWED_USERS=
TRAINING_ALLOWED_ORIGINS=
TRAINING_DB_HOST=
TRAINING_DB_PORT=5432
TRAINING_DB_USER=
TRAINING_DB_PASSWORD=
# Optional trusted PEM CA if required by the existing DB certificate chain.
TRAINING_DB_CA=
# Vertex remains hard-locked even if all of these are populated.
ALLOW_PAID_AI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
