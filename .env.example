# Optional shared-state adapter (the starter runs fully offline with local demo data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebMCP / replay switches.
VITE_ENABLE_3D=0
VITE_PLATEAU_TILESET=

# Optional MapLibre style JSON URL. Without it, the deterministic offline map is used.
VITE_MAPLIBRE_STYLE_URL=

# Explicit training data mode. Shared mode is opt-in; no hosted DB needed.
VITE_LIVINGTOWN_DATA_MODE=local

# Backend-only settings: never prefix these with VITE_.
# The Node backend reads the process environment, not this file automatically.
ASSISTANT_PROVIDER=fake
# Protocol-mock configuration only: this release hard-blocks live/paid AI.
# Neither these variables nor gateway headers can unlock live use.
ALLOW_PAID_AI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
